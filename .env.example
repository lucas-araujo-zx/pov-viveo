# O mesmo token da bancada Almaviva. Se VIVEO_LOGIN_TOKEN estiver vazio,
# o servidor também aceita ALMAVIVA_LOGIN_TOKEN e ICATU_LOGIN_TOKEN.
VIVEO_LOGIN_TOKEN=

# Chave do workspace que contém a Sofia. Em desenvolvimento, se ficar vazia,
# a bancada usa a chave de icatu/lab (a da Almaviva é de outra conta).
ELEVENLABS_API_KEY=

# Sofia. Se vazio, a bancada usa o agente de triagem da Humânia.
VIVEO_VOICE_AGENT=
